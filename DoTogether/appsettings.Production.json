{
  "Jwt": {
    "Issuer": "DoTogether",
    "Audience": "DoTogether",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },
  "Email": {
    "Provider": "Resend",
    "AllowDevelopmentFallback": false,
    "FromName": "DoTogether",
    "Validation": {
      "RequireResolvableDomain": true
    },
    "Smtp": {
      "Port": 587,
      "EnableSsl": true
    },
    "Resend": {
      "BaseUrl": "https://api.resend.com"
    }
  },
  "Gemini": {
    "Model": "gemini-1.5-flash"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
